{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/logo.png",
      "dest": "/frontend/logo.png"
    },
    {
      "src": "/favicon.ico",
      "dest": "/frontend/logo.png"
    },
    {
      "src": "/tokens.css",
      "dest": "/frontend/tokens.css"
    },
    {
      "src": "/fonts/(.*)",
      "dest": "/frontend/fonts/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/frontend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
