# Storage & Firebase Environment Configuration
# Mode: "sqlite" (default local storage) or "firebase" (primary Firebase RTDB with SQLite fallback)
STORAGE_MODE=sqlite

# Admin Security Guard & CORS
ADMIN_TOKEN=
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Backend Firebase Admin SDK (Optional)
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com/
FIREBASE_PROJECT_ID=your-project-id
# Path to your Firebase service account private key JSON (do NOT commit this file)
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: Firebase Emulator Suite endpoints for testing
# FIREBASE_DATABASE_EMULATOR_HOST=localhost:9000
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Frontend Public Web SDK Configuration (Non-secret identifiers)
VITE_FIREBASE_API_KEY=AIzaSy_YOUR_FIREBASE_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ==============================================================================
# Image Generation Provider Selection
# ==============================================================================
# Commercial Provider: OpenAI DALL-E (dall-e-2 for Economy, dall-e-3 standard/hd)
OPENAI_API_KEY=

# Google AI Studio / Gemini API Key (Gemini models and multimodal generation)
GEMINI_API_KEY=

# Groq API Keys for Prompt Pre-verification & Chatbot
GROQ_API_KEY=
GROQ_API_KEY_FALLBACK=
GROQ_API_KEY_FALLBACK_2=

# Enable real prompt-matched live diffusion (default: true)
ENABLE_LIVE_DIFFUSION=true

# Per-session generation cap to prevent accidental overspending (default: 10)
REAL_GENERATION_CAP=10

