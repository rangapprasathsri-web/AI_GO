# Adaptive AI Request Optimizer - Environment Configuration
# All components operate 100% offline without third-party credentials.
# Real provider integrations activate automatically if valid keys are provided below.

# Server settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Storage
DATABASE_PATH=data/optimizer.db

# Upstream Provider Credentials (Optional - mock mode active by default)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Safety & Governance
DEFAULT_SCHOOL_MONTHLY_BUDGET=20.00
APPROVAL_REQUIRED_ABOVE_COST=0.10
ENABLE_OUTPUT_MODERATION=true
