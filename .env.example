# Backend Firebase Admin SDK
FIREBASE_DATABASE_URL=https://ai-go-a6a7a-default-rtdb.firebaseio.com/
FIREBASE_PROJECT_ID=ai-go-a6a7a
# Path to your Firebase service account private key JSON (do NOT commit this file)
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: Firebase Emulator Suite endpoints for testing
# FIREBASE_DATABASE_EMULATOR_HOST=localhost:9000
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Frontend Public Web SDK Configuration (Non-secret identifiers)
VITE_FIREBASE_API_KEY=AIzaSyBBZnwuhgTlUEpaAvZDX0QMbVREymFdKKc
VITE_FIREBASE_AUTH_DOMAIN=ai-go-a6a7a.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ai-go-a6a7a
VITE_FIREBASE_STORAGE_BUCKET=ai-go-a6a7a.firebasestorage.app
VITE_FIREBASE_MEASUREMENT_ID=G-732E5Q2M9M

# ==============================================================================
# Image Generation Provider Selection
# ==============================================================================
# Commercial Provider: OpenAI DALL-E (dall-e-2 for Economy, dall-e-3 standard/hd)
OPENAI_API_KEY=

# Google AI Studio / Gemini API Key (Gemini models and multimodal generation)
